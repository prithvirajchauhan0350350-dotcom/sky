# SKY — environment file. Sirf keys rakhta hai; Sky kabhi secret log/store nahi karta.
# Brain profile config.json -> "brain" me chunti hai (default: omni).

# Active brain ki API key (default env name: OMNIROUTE_API_KEY).
# Apne provider (OpenAI/GLM/koi bhi OpenAI-compatible) ki key yahan daalo:
OMNIROUTE_API_KEY=PUT_YOUR_KEY_HERE

# Optional overrides (khali chhodo to config.json ki value chalegi):
#SKY_MODEL=
#SKY_BASE_URL=
#SKY_BRAIN=omni
#SKY_API_KEY_ENV=OMNIROUTE_API_KEY
